# Conexão com o Postgres (use um usuário SÓ LEITURA)
DB_HOST=postgres-hub
DB_PORT=5432
DB_NAME=personal_hub_db
DB_USER=bot_readonly
# preencha no seu .env local (nunca commite a senha real)
DB_PASSWORD=

# Usuário de ESCRITA restrito — precisa de GRANT apenas em financas_compromissos
# (usado só pelo CRUD de compromissos da página /previsibilidade)
DB_WRITER_USER=dash_writer
DB_WRITER_PASSWORD=
